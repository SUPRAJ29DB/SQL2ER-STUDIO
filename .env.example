# SQL2ER Studio Environment Configuration

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=sql2er_super_secret_development_key_change_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# AI / LLM Configuration
LLM_PROVIDER=offline
# Supported: offline, openai, gemini, anthropic, ollama
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=gpt-4o-mini

# Database Connection Defaults (Optional)
DEFAULT_DB_TYPE=sqlite
DEFAULT_DB_PATH=./database/sql2er_local.db

# Storage & Exports
EXPORTS_DIR=./exports
MAX_UPLOAD_SIZE_MB=50

